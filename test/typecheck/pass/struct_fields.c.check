// Movable Slice is stored/passed by pointer; FixedSlice is stored/passed by
// value. Both work as struct fields, and fixed operations take its address.
#include "arena.h"

typedef Slice(int) ints;
typedef FixedSlice(int) fints;

struct Record {
  ints items;
  ints* extra;
  fints fixed;
};

static fints build_fixed(Arena* arena) {
  fints b = {0};
  SliceFixed(arena, &b, 4);
  *Push(&b) = 1;
  return b;
}

int use(Arena* arena, fints view) {
  *Push(&view) = 2;  // mutates the local by-value descriptor only

  struct Record* r = New(arena, struct Record);
  *PushGrow(arena, &r->items) = 3;

  r->extra = New(arena, ints);
  *PushGrow(arena, r->extra) = 4;

  r->fixed = build_fixed(arena);  // fixed descriptor stored by value
  *Push(&r->fixed) = 5;

  bool movable_tip = SliceAtTip(arena, &r->items);
  bool fixed_tip = SliceAtTip(arena, &r->fixed);
  (void)movable_tip;
  (void)fixed_tip;

  return r->items.data[0] + r->extra->data[0] + r->fixed.data[0] + view.len;
}
