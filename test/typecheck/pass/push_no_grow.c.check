// Push is the checked, non-growing path for both Slice classes.
#include "arena.h"

typedef Slice(int) ints;
typedef FixedSlice(int) fints;

int use(Arena* arena) {
  ints* s = New(arena, ints);
  Reserve(arena, s, 4);

  int* a = TryPush(arena, s);
  *a = 1;
  int* b = TryPush(arena, s);
  *b = 2;

  fints f = {0};
  SliceFixed(arena, &f, 2);
  int* c = TryPush(&f);
  *c = 3;
  int* d = TryPush(&f);
  *d = 4;
  int* full = TryPush(&f);  // compiles; NULL at runtime
  (void)full;

  return (int)(s->len + f.len);
}
