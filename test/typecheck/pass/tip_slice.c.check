// TipSlice(T) is a one-descriptor array tagged TipKind: the three-argument
// Push/Reserve select the non-moving at-tip path.
#include "arena.h"

typedef Slice(int) ints;
typedef TipSlice(int) tints;

_Static_assert(sizeof(tints) == sizeof(SliceInternal), "TipSlice size");
_Static_assert(alignof(tints) == alignof(SliceInternal), "TipSlice align");
_Static_assert(offsetof(__typeof__(*((tints){0})), data) == offsetof(SliceInternal, data), "data");
_Static_assert(offsetof(__typeof__(*((tints){0})), len) == offsetof(SliceInternal, len), "len");
_Static_assert(offsetof(__typeof__(*((tints){0})), cap) == offsetof(SliceInternal, cap), "cap");

int use(Arena* arena) {
  tints t = {};
  SliceTip(arena, t, 2);

  int* p = Push(arena, t, 1);
  Push(arena, t, 2);
  Push(arena, t, 3);
  Reserve(arena, t, 8);

  ints copy = {};
  Clone(arena, copy, t);
  Push(arena, copy, 4);

  return *p + t->data[1] + copy->data[2] + (int)SliceAtTip(arena, t);
}
