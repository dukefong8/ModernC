// PushUnchecked is Push minus the bounds check and the arena argument: the
// same strict element-type guard, for a slice the caller reserved room in.
#include "arena.h"

struct A {
  int v;
};

typedef Slice(struct A) as;
typedef Slice(int) ints;
typedef Slice(const char*) strs;

void use(Arena* arena, as* xs, ints* is, strs* ss) {
  Reserve(arena, is, 4);
  int* q = PushUnchecked(is, 42);
  *q += 1;
  PushUnchecked(is, 43);  // second push still inside the reserved room

  Reserve(arena, xs, 2);
  struct A a = {7};
  struct A* p = PushUnchecked(xs, a);
  p->v = a.v;

  Reserve(arena, ss, 1);
  const char* lit = "hi";
  PushUnchecked(ss, lit);
}
