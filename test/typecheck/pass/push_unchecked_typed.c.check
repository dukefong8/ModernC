// PushUnchecked is Push minus the bounds check and arena argument.
#include "arena.h"

struct A { int v; };

typedef Slice(struct A) as;
typedef Slice(int) ints;
typedef Slice(const char*) strs;

void use(Arena* arena, as *xs, ints *is, strs *ss) {
  Reserve(arena, is, 4);
  isize q = PushUnchecked(is, 42);
  At(is, q) += 1;
  PushUnchecked(is, 43);

  Reserve(arena, xs, 2);
  struct A a = {7};
  isize p = PushUnchecked(xs, a);
  At(xs, p).v = a.v;

  Reserve(arena, ss, 1);
  const char* lit = "hi";
  PushUnchecked(ss, lit);
}
