// Slice(T) descriptor layout and an over-aligned element type.
#include "arena.h"

struct __attribute__((aligned(64))) Wide {
  double v[2];
};

typedef Slice(struct Wide) wides;

_Static_assert(sizeof(wides) == sizeof(SliceInternal), "no descriptor overhead");
_Static_assert(alignof(wides) == alignof(SliceInternal), "descriptor alignment");

int use(Arena* arena) {
  struct Wide wide[] = {{{1, 2}}, {{3, 4}}};
  wides* local = New(arena, wides);
  SliceFromArray(arena, local, wide);
  return (int)local->len + (int)local->data[0].v[0];
}
