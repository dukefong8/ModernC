// Push returns a typed slot; the store is an ordinary C assignment.
#include "arena.h"

struct A { int v; };

typedef Slice(struct A) as;
typedef Slice(int) ints;
typedef Slice(const char*) strs;

void use(Arena* arena, as *xs, ints *is, strs *ss) {
  struct A a = {7};
  struct A* p = Push(arena, xs);
  *p = a;

  int* q = Push(arena, is);
  *q = 42;

  const char* lit = "hi";
  *Push(arena, ss) = lit;
}
