// Push accepts exactly-matching element types and yields the new index.
#include "arena.h"

struct A { int v; };

typedef Slice(struct A) as;
typedef Slice(int) ints;
typedef Slice(const char*) strs;

void use(Arena* arena, as *xs, ints *is, strs *ss) {
  struct A a = {7};
  isize p = Push(arena, xs, a);
  At(xs, p).v = a.v;

  isize q = Push(arena, is, 42);
  At(is, q) += 1;

  const char* lit = "hi";
  Push(arena, ss, lit);
}
