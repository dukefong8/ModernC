// FixedSlice(T) is a plain fixed-capacity descriptor: TryPush(&b) only.
#include "arena.h"

typedef Slice(int) ints;
typedef FixedSlice(int) fints;

_Static_assert(sizeof(fints) == sizeof(SliceInternal), "FixedSlice size");
_Static_assert(alignof(fints) == alignof(SliceInternal), "FixedSlice align");
_Static_assert(offsetof(fints, data) == offsetof(SliceInternal, data), "data");
_Static_assert(offsetof(fints, len) == offsetof(SliceInternal, len), "len");
_Static_assert(offsetof(fints, cap) == offsetof(SliceInternal, cap), "cap");

int use(Arena* arena) {
  fints b = {0};
  SliceFixed(arena, &b, 8);
  int* i0 = TryPush(&b);
  *i0 = 1;
  int* i1 = TryPush(&b);
  *i1 = 2;
  (void)i0;
  (void)i1;
  *TryPush(&b) = 3;

  ints* cloned = New(arena, ints);
  Clone(arena, cloned, &b);

  return b.data[0] + cloned->data[1] + (int)cloned->cap;
}
