// Two slice classes and their legal conversions.
#include "arena.h"

typedef Slice(int) ints;
typedef FixedSlice(int) fints;

int use(Arena* arena) {
  /* movable: array copy + Clone destination */
  int stack_data[] = {1, 2, 3};
  ints fixed = {};
  SliceFromArray(arena, fixed, stack_data);
  ints movable = {};
  Clone(arena, movable, fixed);
  Reserve(arena, fixed, 8);
  Push(arena, fixed, 10);

  /* fixed */
  fints b = {};
  SliceFixed(arena, b, 4);
  (void)Push(b, 1);
  (void)Push(b, 2);
  ints out = {};
  Clone(arena, out, b);

  return fixed->data[0] + movable->data[0] + b->data[0] + out->data[0];
}
