// EXPECT: array argument must be a non-empty array
// C has no standard zero-length array; use the empty slice initializer
// {.data = NULL, .len = 0, .cap = 0} instead.
#include "arena.h"

typedef Slice(int) ints;

void use(Arena* arena) {
  int data[0];
  ints s = {};
  SliceFromArray(arena, s, data);
}
