// EXPECT: not compatible with any .*association
// A hand-written descriptor with an unknown tag must not silently take the
// movable path: the 3-argument Push names both known tags and has no default.
#include "arena.h"

typedef struct { unsigned char _; } WrongKind;
typedef __typeof__(( (union { struct { int *data; long len, cap; }; WrongKind _kind; }[1]){} )) Weird;

void use(Arena* arena) {
  Weird w = {};
  Push(arena, w, 1);
}
