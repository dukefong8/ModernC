// EXPECT: expected a movable Slice
// PushGrow requires a plain movable Slice, not a FixedSlice value:
// FixedKind matches no _Generic association.
#include "arena.h"

typedef FixedSlice(int) fints;

void use(Arena* arena) {
  fints b = {0};
  SliceFixed(arena, &b, 4);
  *PushGrow(arena, &b) = 1;
}
