// EXPECT: not compatible with any .*association
// The growable Push requires a plain Slice, not a FixedSlice handle:
// FixedKind matches no _Generic association.
#include "arena.h"

typedef FixedSlice(int) fints;

void use(Arena* arena) {
  fints b = {};
  SliceFixed(arena, b, 4);
  Push(arena, b, 1);
}
