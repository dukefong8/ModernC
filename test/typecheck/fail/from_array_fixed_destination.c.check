// EXPECT: expected a movable Slice destination
// SliceFromArray destination must be a movable Slice, not a FixedSlice
// value: FixedKind matches no _Generic association.
#include "arena.h"

typedef FixedSlice(int) fints;

void use(Arena* arena) {
  int data[] = {1, 2, 3};
  fints b = {0};
  SliceFromArray(arena, &b, data);
}
