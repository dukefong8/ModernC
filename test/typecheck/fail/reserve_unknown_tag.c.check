// EXPECT: expected a movable Slice
// Same as push_unknown_tag, for Reserve: an unknown tag is a static-assert
// error, not a silent movable reserve.
#include "arena.h"

typedef struct { unsigned char _; } WrongKind;
typedef union { struct { int *data; long len, cap; }; WrongKind _kind; } Weird;

void use(Arena* arena) {
  Weird* w = New(arena, Weird);
  Reserve(arena, w, 8);
}
